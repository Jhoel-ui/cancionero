rules_version = '2';
// Cualquiera con el link puede ver (menos las alabanzas "solo equipo"). Editar: miembros del equipo con su cuenta de Google.
// Borrar alabanzas y cambiar el equipo: solo líderes. La lista está en config/equipo:
//   { miembros: ["correo@gmail.com", ...], lideres: ["correo@gmail.com", ...] }
// El dueño siempre es líder (así puede crear la lista desde la página, en "Equipo").
service cloud.firestore {
  match /databases/{database}/documents {
    function rutaEquipo() { return /databases/$(database)/documents/config/equipo; }
    function equipo() { return get(rutaEquipo()).data; }
    function correo() { return request.auth.token.email.lower(); }
    function dueno() { return request.auth != null && correo() == "rojasaire@gmail.com"; }
    function lider() { return dueno() || (request.auth != null && exists(rutaEquipo()) && correo() in equipo().lideres); }
    function miembro() { return lider() || (request.auth != null && exists(rutaEquipo()) && correo() in equipo().miembros); }

    match /canciones/{id} {
      allow read: if true;
      allow create, update: if miembro();
      allow delete: if lider();
    }
    // Alabanzas "solo equipo" (de otros artistas): no se ven en la página pública.
    match /canciones_equipo/{id} {
      allow read, create, update: if miembro();
      allow delete: if lider();
    }
    match /repertorios/{fecha} {
      allow read: if true;
      allow write: if miembro();
    }
    // Partituras privadas por instrumento: cada colección la leen solo el dueño y los correos de su lista
    // acceso/<instrumento> { permitidos: [...] }. El saxofonista no ve las de trompeta ni al revés.
    function ve(instr) {
      return dueno() || (request.auth != null
        && exists(/databases/$(database)/documents/acceso/$(instr))
        && correo() in get(/databases/$(database)/documents/acceso/$(instr)).data.permitidos);
    }
    match /partituras_saxo/{id} {
      allow read: if ve("saxo");
      allow write: if dueno();
    }
    match /partituras_trompeta/{id} {
      allow read: if ve("trompeta");
      allow write: if dueno();
    }
    // Colección vieja (todas juntas): solo el dueño, para poder borrarla.
    match /partituras/{id} {
      allow read, write: if dueno();
    }
    match /acceso/{doc} {
      allow read, write: if dueno();
    }
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if lider();
    }
  }
}
