rules_version = '2';
// Dos ministerios en la misma página, cada uno con lo suyo. Nadie de un ministerio puede leer ni tocar lo del otro.
//  - Renovación: colecciones en la raíz (canciones, repertorios, partituras_…, acceso, config/equipo).
//  - Renuevo: lo mismo, dentro de ministerios/renuevo/…
// Todo es solo para el equipo de cada uno (hay que entrar con Google y estar en su lista config/equipo):
//   { miembros: ["correo@gmail.com", ...], lideres: ["correo@gmail.com", ...] }
// Editar: miembros. Borrar alabanzas y cambiar el equipo: líderes. El dueño de cada ministerio siempre es líder.
// Partituras: cada instrumento tiene su lista acceso/<instrumento> { permitidos: [...] }; solo el dueño sube y cambia listas.
service cloud.firestore {
  match /databases/{database}/documents {
    function correo() { return request.auth.token.email.lower(); }
    function conCuenta() { return request.auth != null; }

    // ---------- Renovación ----------
    function rutaEquipo() { return /databases/$(database)/documents/config/equipo; }
    function equipo() { return get(rutaEquipo()).data; }
    function dueno() { return conCuenta() && correo() == "rojasaire@gmail.com"; }
    function lider() { return dueno() || (conCuenta() && exists(rutaEquipo()) && correo() in equipo().lideres); }
    function miembro() { return lider() || (conCuenta() && exists(rutaEquipo()) && correo() in equipo().miembros); }
    function ve(instr) {
      return dueno() || (conCuenta()
        && exists(/databases/$(database)/documents/acceso/$(instr))
        && correo() in get(/databases/$(database)/documents/acceso/$(instr)).data.permitidos);
    }

    match /canciones/{id} {
      allow read, create, update: if miembro();
      allow delete: if lider();
    }
    match /canciones_equipo/{id} {
      allow read, create, update: if miembro();
      allow delete: if lider();
    }
    match /repertorios/{id} {
      allow read, write: if miembro();
    }
    match /partituras_saxo/{id} {
      allow read: if ve("saxo");
      allow write: if dueno();
    }
    match /partituras_trompeta/{id} {
      allow read: if ve("trompeta");
      allow write: if dueno();
    }
    // Colección vieja (todas juntas): solo el dueño, para poder borrarla.
    match /partituras/{id} {
      allow read, write: if dueno();
    }
    match /acceso/{doc} {
      allow read, write: if dueno();
    }
    match /config/{doc} {
      allow read: if miembro();
      allow write: if lider();
    }

    // ---------- Renuevo ----------
    function rRutaEquipo() { return /databases/$(database)/documents/ministerios/renuevo/config/equipo; }
    function rEquipo() { return get(rRutaEquipo()).data; }
    // Rodri tiene control total en Renuevo por ahora (lo saben); quitarlo aquí y en ministerio.js ("admin") cuando ya no haga falta.
    function rDueno() { return conCuenta() && (correo() == "jd.nivek123@gmail.com" || correo() == "rojasaire@gmail.com"); }
    function rLider() { return rDueno() || (conCuenta() && exists(rRutaEquipo()) && correo() in rEquipo().lideres); }
    function rMiembro() { return rLider() || (conCuenta() && exists(rRutaEquipo()) && correo() in rEquipo().miembros); }
    function rVe(instr) {
      return rDueno() || (conCuenta()
        && exists(/databases/$(database)/documents/ministerios/renuevo/acceso/$(instr))
        && correo() in get(/databases/$(database)/documents/ministerios/renuevo/acceso/$(instr)).data.permitidos);
    }

    match /ministerios/renuevo/canciones/{id} {
      allow read, create, update: if rMiembro();
      allow delete: if rLider();
    }
    match /ministerios/renuevo/canciones_equipo/{id} {
      allow read, create, update: if rMiembro();
      allow delete: if rLider();
    }
    match /ministerios/renuevo/repertorios/{id} {
      allow read, write: if rMiembro();
    }
    match /ministerios/renuevo/partituras_saxo/{id} {
      allow read: if rVe("saxo");
      allow write: if rDueno();
    }
    match /ministerios/renuevo/partituras_trompeta/{id} {
      allow read: if rVe("trompeta");
      allow write: if rDueno();
    }
    match /ministerios/renuevo/partituras/{id} {
      allow read, write: if rDueno();
    }
    match /ministerios/renuevo/acceso/{doc} {
      allow read, write: if rDueno();
    }
    match /ministerios/renuevo/config/{doc} {
      allow read: if rMiembro();
      allow write: if rLider();
    }
    // Cualquier otra cosa: cerrada.
  }
}
